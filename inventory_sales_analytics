    purchases = query_df("""SELECT pu.purchase_no,pu.purchase_date,p.sku,p.name AS product,pu.quantity,pu.unit_cost,
                            pu.quantity*pu.unit_cost AS purchase_total,pu.supplier
                            FROM purchases pu JOIN products p ON p.id=pu.product_id ORDER BY pu.purchase_date DESC""")
    c1,c2,c3 = st.columns(3)
    c1.download_button("Export products CSV", products.to_csv(index=False).encode("utf-8-sig"), "products.csv", "text/csv", use_container_width=True)
    c2.download_button("Export sales CSV", sales.to_csv(index=False).encode("utf-8-sig"), "sales.csv", "text/csv", use_container_width=True)
    c3.download_button("Export purchases CSV", purchases.to_csv(index=False).encode("utf-8-sig"), "purchases.csv", "text/csv", use_container_width=True)
    st.divider()
    st.subheader("Restock recommendations")
    if sales.empty:
        st.info("Record sales to generate demand-based recommendations.")
    else:
        recent_start = (date.today()-timedelta(days=30)).isoformat()
        recent = query_df("""SELECT product_id,SUM(quantity) AS units_sold FROM sales WHERE sale_date>=? GROUP BY product_id""",(recent_start,))
        merged = query_df("SELECT id,sku,name,category,stock_qty,reorder_level FROM products")
        merged = merged.merge(recent, left_on="id", right_on="product_id", how="left").drop(columns=["product_id"])
        merged["units_sold"] = merged["units_sold"].fillna(0).astype(int)
        merged["avg_daily_demand"] = (merged["units_sold"]/30).round(2)
        merged["estimated_days_left"] = merged.apply(lambda r: round(r["stock_qty"]/r["avg_daily_demand"],1) if r["avg_daily_demand"]>0 else None, axis=1)
        merged["suggested_reorder_qty"] = merged.apply(lambda r: max(0, int(round(r["avg_daily_demand"]*30-r["stock_qty"]))) if r["avg_daily_demand"]>0 else max(0,int(r["reorder_level"]-r["stock_qty"])), axis=1)
        merged["recommendation"] = merged.apply(lambda r: "Restock soon" if r["stock_qty"]<=r["reorder_level"] or (r["estimated_days_left"] is not None and r["estimated_days_left"]<10) else "Stock OK",axis=1)
        st.dataframe(merged[["sku","name","category","stock_qty","units_sold","avg_daily_demand","estimated_days_left","suggested_reorder_qty","recommendation"]]
                     .sort_values(["recommendation","estimated_days_left"], ascending=[True,True]), use_container_width=True, hide_index=True)
        st.caption("Recommendation is a simple heuristic based on the last 30 days; it is not a forecast guarantee.")

