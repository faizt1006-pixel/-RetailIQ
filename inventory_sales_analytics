# ---------- Record sale ----------
elif page == "Record a Sale":
    st.title("Record a sale")
    st.caption("Recording a sale creates an invoice and deducts stock in a single database transaction.")
    products = load_products()
    if products.empty:
        st.warning("Add products before recording sales.")
    else:
        available = products[products["stock_qty"] > 0]
        if available.empty:
            st.warning("There is no stock available to sell.")
        else:
            with st.form("sale_form"):
                pid = st.selectbox("Product", available["id"], format_func=lambda x: f'{available.loc[available.id==x,"name"].iloc[0]} — {int(available.loc[available.id==x,"stock_qty"].iloc[0])} in stock')
                p = available[available.id==pid].iloc[0]
                c1,c2,c3 = st.columns(3)
                qty = c1.number_input("Quantity", min_value=1, max_value=int(p["stock_qty"]), value=1, step=1)
                unit_price = c2.number_input("Selling price per unit (₹)", min_value=0.0, value=float(p["selling_price"]), step=1.0)
                discount = c3.number_input("Total discount (₹)", min_value=0.0, value=0.0, step=10.0)
                sale_date = st.date_input("Sale date", value=date.today())
                customer = st.text_input("Customer name", value="Walk-in Customer")
                payment = st.selectbox("Payment method", ["UPI","Cash","Card","Bank transfer","Other"])
                total = int(qty)*unit_price-discount
                st.info(f"Invoice total: **{money(total)}**  ·  Estimated gross profit: **{money(total-int(qty)*float(p['cost_price']))}**")
                ok = st.form_submit_button("Save sale & update stock", type="primary")
                if ok:
                    if discount > int(qty)*unit_price:
                        st.error("Discount cannot exceed the sale value.")
                    else:
                        invoice = next_ref("INV")
                        try:
                            with get_conn() as conn:
                                current = conn.execute("SELECT stock_qty FROM products WHERE id=?",(int(pid),)).fetchone()["stock_qty"]
                                if int(qty) > current:
                                    st.error("Not enough stock available.")
                                else:
                                    conn.execute("""INSERT INTO sales(invoice_no,product_id,quantity,unit_price,unit_cost,discount,sale_date,customer_name,payment_method)
                                                    VALUES(?,?,?,?,?,?,?,?,?)""",
                                                 (invoice,int(pid),int(qty),unit_price,float(p["cost_price"]),discount,sale_date.isoformat(),customer.strip(),payment))
                                    conn.execute("UPDATE products SET stock_qty=stock_qty-? WHERE id=?",(int(qty),int(pid)))
                                    conn.execute("""INSERT INTO stock_movements(product_id,movement_type,quantity_change,reference,movement_date,notes)
                                                    VALUES(?,'SALE',?,?,?,?)""",
                                                 (int(pid),-int(qty),invoice,sale_date.isoformat(),"Sale recorded"))
                            st.success(f"Sale saved. Invoice: {invoice}")
                            st.rerun()
                        except sqlite3.IntegrityError as e:
                            st.error(f"Could not save sale: {e}")

