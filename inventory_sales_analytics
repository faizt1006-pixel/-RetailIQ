            trend = trend.groupby(trend["sale_date"].dt.to_period("D").astype(str), as_index=False)["net_sales"].sum()
            trend.columns = ["Date", "Net sales"]
            fig = px.line(trend, x="Date", y="Net sales", markers=True, template="plotly_white")
            fig.update_layout(margin=dict(l=10,r=10,t=20,b=10), height=320)
            st.plotly_chart(fig, use_container_width=True)
        else:
            st.info("No sales in the selected period.")
    with right:
        st.subheader("Sales by category")
        if not sales.empty:
            cat = sales.groupby("category", as_index=False)["net_sales"].sum().sort_values("net_sales", ascending=False)
            fig = px.pie(cat, names="category", values="net_sales", hole=0.55, template="plotly_white")
            fig.update_layout(margin=dict(l=5,r=5,t=20,b=5), height=320, legend_title="")
            st.plotly_chart(fig, use_container_width=True)
        else:
            st.info("Category chart will appear when sales exist.")

    left, right = st.columns(2)
    with left:
        st.subheader("Top products by revenue")
        if not sales.empty:
            top = sales.groupby("product_name", as_index=False)["net_sales"].sum().sort_values("net_sales", ascending=False).head(8)
            fig = px.bar(top, x="net_sales", y="product_name", orientation="h", template="plotly_white",
                         labels={"net_sales":"Net sales","product_name":"Product"})
            fig.update_layout(yaxis={"categoryorder":"total ascending"}, margin=dict(l=5,r=5,t=15,b=5), height=320)
            st.plotly_chart(fig, use_container_width=True)
        else:
            st.info("No product sales to chart.")
    with right:
        st.subheader(f"Stock alerts ({len(low_stock)})")
        if low_stock.empty:
            st.success("No products are at or below their reorder level.")
        else:
            display = low_stock[["sku","name","category","stock_qty","reorder_level"]].rename(columns={
                "sku":"SKU","name":"Product","category":"Category","stock_qty":"In stock","reorder_level":"Reorder at"})
            st.dataframe(display, use_container_width=True, hide_index=True)
    st.caption(f"Orders in period: {order_count:,} • Inventory retail value: {money(inventory_retail)} • Figures are calculated from recorded transactions.")

