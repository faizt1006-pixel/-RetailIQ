    low_stock = products[products["stock_qty"] <= products["reorder_level"]]
    if not sales.empty:
        sales["gross_sales"] = sales["quantity"] * sales["unit_price"]
        sales["net_sales"] = sales["gross_sales"] - sales["discount"]
        sales["gross_profit"] = sales["net_sales"] - (sales["quantity"] * sales["unit_cost"])
        revenue = sales["net_sales"].sum()
        gross_profit = sales["gross_profit"].sum()
        units_sold = int(sales["quantity"].sum())
        order_count = sales["invoice_no"].nunique()
        margin = gross_profit / revenue * 100 if revenue else 0
    else:
        revenue = gross_profit = units_sold = order_count = margin = 0

    k = st.columns(5)
    k[0].metric("Net sales", money(revenue))
    k[1].metric("Gross profit", money(gross_profit))
    k[2].metric("Gross margin", f"{margin:.1f}%")
    k[3].metric("Units sold", f"{units_sold:,}")
    k[4].metric("Inventory at cost", money(inventory_value))
    st.divider()

    left, right = st.columns([1.45, 1])
